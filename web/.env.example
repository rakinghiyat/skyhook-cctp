# The sponsor route reads these from the platform's environment.
# On Vercel: Project → Settings → Environment Variables.
#
# SPONSOR_SECRET_KEY is the only secret, and it never reaches the browser — the page posts a
# signed transaction to /api/sponsor and the route does the rest.
#
# Locally, .env.local is a symlink to the repo-root .env, so there is only ever one copy.
SPONSOR_SECRET_KEY=
HANDLER_HOLD_ID=CCLVTDVGYHSWFC7AW2L327WMFZVKZDFYY24G7Z4IZO2SQDM4DVWE7TC6
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
