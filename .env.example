# Copy to .env and fill in. Never commit .env (it is gitignored).
# Testnet only. No mainnet keys belong in this project.

# ── Stellar ───────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Relayer account. Submits Skyhook.execute and pays the transaction fee.
# Holds no user funds, but does need its own XLM balance.
RELAYER_SECRET_KEY=
RELAYER_PUBLIC_KEY=

# Fee-bump sponsor. Wraps claim() so the recipient signs without holding XLM.
# One Testnet account is enough. No key rotation, no rate limiting.
SPONSOR_SECRET_KEY=
SPONSOR_PUBLIC_KEY=

# ── Circle CCTP ───────────────────────────────────────────────────────────
CIRCLE_ATTESTATION_API=https://iris-api-sandbox.circle.com

# ── Source chain (EVM testnet) ────────────────────────────────────────────
# Arc Testnet. Circle domain 26; Stellar (destination) is domain 27.
SOURCE_RPC_URL=https://rpc.testnet.arc.io
SOURCE_CHAIN_ID=5042002
SOURCE_PRIVATE_KEY=
SOURCE_DOMAIN_ID=26
SOURCE_EXPLORER=https://testnet.arcscan.app

# Circle contracts on Arc Testnet. Public, not secrets.
# Verified via docs.arc.io on 2026-08-25.
ARC_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
ARC_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
ARC_USDC=0x3600000000000000000000000000000000000000

# ── Deployed contract IDs ─────────────────────────────────────────────────
# The live Testnet deployment, the same values the README's address table lists.
# Public, not secrets. Replace them only if you deploy your own.
SKYHOOK_CORE_ID=CCOMST7FEDLYJ5MXZTVKVKMK43AQP2U2AZEZRHE3XHYO6UF6LKC2654F
HANDLER_DEPOSIT_ID=CBZOKXZKKORG4FI5URPJMX3XHBDU6E7EXPD4YY36R36PHVOMEKWXRVFY
HANDLER_HOLD_ID=CCLVTDVGYHSWFC7AW2L327WMFZVKZDFYY24G7Z4IZO2SQDM4DVWE7TC6
REFERENCE_VAULT_ID=CAY6UNOOWATJW2LXFGMTO6NKLJRVWRKMNVZVPGLKRBLE5Y6OFMDF7IB4

# The fallback_recipient in the instruction: who gets the vault shares or the funds in Hold.
# The demo wallet (Varial, formerly Freighter). If unset, a burn quietly goes to the relayer.
FREIGHTER_RECIPIENT=

# Circle's contracts on Stellar Testnet. Public, not secrets.
# Verified on-chain via `stellar contract info interface` on 2026-08-25.
CCTP_FORWARDER_ID=CA66Q2WFBND6V4UEB7RD4SAXSVIWMD6RA4X3U32ELVFGXV5PJK4T4VSZ
MESSAGE_TRANSMITTER_ID=CBJ6MTCKKZG73PMDZCJMSFRD7DQEMI4FKDH7CGDSV4W6FHCRBCQAVVJY
TOKEN_MESSENGER_MINTER_ID=CDNG7HXAPBWICI2E3AUBP3YZWZELJLYSB6F5CC7WLDTLTHVM74SLRTHP
