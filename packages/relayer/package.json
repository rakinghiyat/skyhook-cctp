  "license": "Apache-2.0",
  "type": "module",
  "main": "src/relay.js",
  "bin": {
    "skyhook-relay": "src/cli.js"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakinghiyat/skyhook-cctp.git",
    "directory": "packages/relayer"
  },
  "homepage": "https://www.skyhookcctp.com",
  "bugs": {
    "url": "https://github.com/rakinghiyat/skyhook-cctp/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "cctp",
    "circle",
    "usdc",
    "cross-chain",
    "relayer"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "relay": "node src/cli.js"
  },
  "dependencies": {
    "@skyhook-cctp/sdk": "^0.1.0",
    "@stellar/stellar-sdk": "^17.0.1"
  }
